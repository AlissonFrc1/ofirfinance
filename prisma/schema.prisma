generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id            String    @id @default(uuid())
  value         Decimal
  paid          Boolean   @default(false)
  recurring     Boolean   @default(false)
  date          DateTime
  nextDate      DateTime?
  paymentMethod String
  category      String
  subcategory   String
  fixed         Boolean   @default(false)
  installments  Int?
  description   String?
  dueDay        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CardExpense {
  id                String    @id @default(uuid())
  value             Decimal
  date              DateTime
  dueDate           DateTime
  cardId            String
  category          String
  subcategory       String
  recurring         Boolean   @default(false)
  fixed             Boolean   @default(false)
  installments      Int?
  description       String?
  paid              Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  endRecurrenceDate DateTime?
  card              Card      @relation(fields: [cardId], references: [id])
}

model Income {
  id           String    @id @default(uuid())
  value        Decimal
  received     Boolean   @default(false)
  recurring    Boolean   @default(false)
  date         DateTime
  nextDate     DateTime?
  category     String
  subcategory  String
  fixed        Boolean   @default(false)
  installments Int?
  description  String?
  dueDay       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id         String        @id @default(uuid())
  name       String
  brand      String
  bank       String        @default("Não Informado")
  lastDigits String
  limit      Decimal
  dueDay     Int
  closingDay Int
  color      String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  expenses   CardExpense[]
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  role          Role          @default(USER)
  planId        String?
  plan          Plan?         @relation(fields: [planId], references: [id])
  subscriptions Subscription[]
  expenses      Expense[]
  incomes       Income[]
  cards         Card[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  planId             String
  status             Status   @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  user               User     @relation(fields: [userId], references: [id])
  plan               Plan     @relation(fields: [planId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Plan {
  id            String        @id @default(cuid())
  name          String
  description   String
  price         Float
  billingCycle  BillingCycle @default(MONTHLY)
  features      String[]
  active        Boolean       @default(true)
  status        Status        @default(ACTIVE)
  allowedPages  String[]
  subscriptions Subscription[]
  users         User[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}
